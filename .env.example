# ---- LLM (Anthropic / Claude) ----
# Required for condition enrichment. Without it, worn items are graded FAIR.
ANTHROPIC_API_KEY=
# Default flagship. Use claude-haiku-4-5 for cheaper, faster high-volume grading.
LLM_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CONCURRENCY=5

# ---- Notifier (Discord) ----
# Required for buy alerts. Create one: Server Settings -> Integrations -> Webhooks.
DISCORD_WEBHOOK_URL=
NOTIFIER_TIMEOUT_SECONDS=10

# ---- Scraper anti-bot / resilience ----
SCRAPER_HEADLESS=true
SCRAPER_MIN_DELAY=2
SCRAPER_MAX_DELAY=7
SCRAPER_MAX_RETRIES=3
SCRAPER_NAV_TIMEOUT=30
SCRAPER_MAX_SCROLL_ROUNDS=15
# Optional outbound proxy, e.g. http://user:pass@host:port
SCRAPER_PROXY=

# ---- Analyzer thresholds ----
FUNCTIONAL_INTEGRITY_THRESHOLD=0.85
COSMETIC_FAIR_CEILING=0.4
ANOMALY_Z_THRESHOLD=-1.0

# ---- Orchestrator ----
SCAN_INTERVAL_SECONDS=600
LOG_LEVEL=INFO
